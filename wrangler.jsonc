// Cloudflare deployment settings. Cloudflare builds the site from GitHub
// (npm run build) and serves the dist folder; worker/index.ts only handles
// form submissions and the old RSS address.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeffreyhumble-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // these paths go to the worker first; everything else is served straight from dist
    "run_worker_first": ["/api/*", "/blog"]
  },
  "observability": { "enabled": true }
}
