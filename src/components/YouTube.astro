---
/* A YouTube video. Loads YouTube only when someone presses play. */
interface Props { id: string; title?: string }
const { id, title = "YouTube video" } = Astro.props;
---
<div class="yt" data-id={id}>
  <button type="button" aria-label={`Play: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
    <span class="play" aria-hidden="true"></span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>(".yt").forEach((el) => {
    el.querySelector("button")?.addEventListener("click", () => {
      el.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1" title="YouTube video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
<style>
  .yt { position: relative; aspect-ratio: 16 / 9; width: 100%; background: #000; }
  .yt button { all: unset; cursor: pointer; position: absolute; inset: 0; }
  .yt img { width: 100%; height: 100%; object-fit: cover; }
  .play {
    position: absolute; left: 50%; top: 50%; width: 68px; height: 48px; translate: -50% -50%;
    background: var(--accent); border-radius: 12px;
  }
  .play::after {
    content: ""; position: absolute; left: 27px; top: 14px;
    border-style: solid; border-width: 10px 0 10px 17px; border-color: transparent transparent transparent #fff;
  }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
