---
interface Props {
  links: readonly { label: string; href: string; icon: string }[];
}
const { links } = Astro.props;
const paths: Record<string, string> = {
  linkedin:
    "M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.02h4.56V23H.22V8.02zM8.34 8.02h4.37v2.05h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7v8.3h-4.56v-7.36c0-1.76-.03-4.02-2.45-4.02-2.45 0-2.83 1.92-2.83 3.9V23H8.34V8.02z",
  youtube:
    "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z",
};
---
<ul class="social">
  {links.map((l) => (
    <li>
      <a href={l.href} target="_blank" rel="noopener" aria-label={l.label}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={paths[l.icon]} fill="currentColor" /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .social { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
  .social a { color: inherit; display: block; }
</style>
