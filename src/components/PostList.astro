---
import { postPath, shortDate, type Post } from "../lib/posts";
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<section class="list">
  {posts.map((post) => (
    <article class="item">
      <a class="thumb" href={postPath(post)} tabindex="-1" aria-hidden="true">
        {post.data.image && <img src={post.data.image} alt="" loading="lazy" />}
      </a>
      <div class="text">
        <p class="meta">Jeff Humble <span>•</span> <time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time></p>
        <h2><a href={postPath(post)}>{post.data.title}</a></h2>
        {post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
        <a class="more" href={postPath(post)}>Read More</a>
      </div>
    </article>
  ))}
</section>

<style>
  .list {
    padding: 6.6vw 2vw;
    display: grid;
    gap: 4.5rem;
  }
  .item { display: grid; grid-template-columns: 40fr 54fr; gap: 6%; align-items: start; }
  .thumb img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .meta { margin: 1.5rem 0 0.8rem; }
  .meta span { margin: 0 0.3em; }
  h2 { font-size: var(--fs-h2); line-height: 1.2; margin-bottom: 1rem; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { opacity: 0.7; }
  .excerpt { margin-bottom: 1rem; }
  @media (max-width: 767px) {
    .list { padding: 10vw 6vw; gap: 3rem; }
    .item { grid-template-columns: 1fr; gap: 0; }
  }
</style>
