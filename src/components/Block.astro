---
/*
  One item placed on a Section's grid.
  m / d are "row-start / column-start / row-end / column-end" for mobile and desktop.
  valign: where the content sits inside its cell (top | middle | bottom).
*/
interface Props {
  m: string;
  d: string;
  z?: number;
  zm?: number;
  valign?: "top" | "middle" | "bottom";
  valignM?: "top" | "middle" | "bottom";
  class?: string;
}
const { m, d, z = 1, zm, valign = "middle", valignM, class: cls = "" } = Astro.props;
const flex = { top: "flex-start", middle: "center", bottom: "flex-end" };
const style = `--m:${m};--d:${d};--z:${z};--zm:${zm ?? z};--va:${flex[valign]};--va-m:${flex[valignM ?? valign]}`;
---
<div class={`block ${cls}`} style={style}><slot /></div>

<style>
  .block {
    grid-area: var(--m);
    z-index: var(--zm);
    display: flex;
    flex-direction: column;
    justify-content: var(--va-m);
    min-width: 0;
  }
  @media (min-width: 768px) {
    .block { grid-area: var(--d); z-index: var(--z); justify-content: var(--va); }
  }
</style>
