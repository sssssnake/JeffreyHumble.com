---
/* Rotating testimonials with arrow buttons (Squarespace's list slideshow). */
interface Item { quote: string; author: string; image?: string }
interface Props { items: Item[]; theme?: string; minHeight?: string; padding?: string }
const { items, theme = "white", minHeight = "30vh", padding = "0vmax" } = Astro.props;
---
<section class={`testimonials theme-${theme}`} style={`--min-h:${minHeight};--pad:${padding}`} aria-roledescription="carousel" aria-label="Testimonials">
  <div class="slides">
    {items.map((item, i) => (
      <figure class="slide" hidden={i !== 0} aria-roledescription="slide" aria-label={`${i + 1} of ${items.length}`}>
        {item.image && <img class="bg" src={item.image} alt="" loading="lazy" />}
        <blockquote>{item.quote}</blockquote>
        <figcaption>{item.author}</figcaption>
      </figure>
    ))}
  </div>
  {items.length > 1 && (
    <>
      <button class="nav prev" type="button" aria-label="Previous testimonial">←</button>
      <button class="nav next" type="button" aria-label="Next testimonial">→</button>
    </>
  )}
</section>
<script>
  document.querySelectorAll<HTMLElement>(".testimonials").forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>(".slide")];
    let i = 0;
    const show = (n: number) => {
      slides[i].hidden = true;
      i = (n + slides.length) % slides.length;
      slides[i].hidden = false;
    };
    root.querySelector(".prev")?.addEventListener("click", () => show(i - 1));
    root.querySelector(".next")?.addEventListener("click", () => show(i + 1));
  });
</script>
<style>
  .testimonials { position: relative; padding: var(--pad) 0; }
  .slides { display: grid; }
  .slide {
    position: relative; margin: 0; min-height: var(--min-h);
    display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;
    padding: 2rem 12vw;
  }
  .slide[hidden] { display: none; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }
  blockquote {
    margin: 0 auto 1.5rem; max-width: 50vw;
    font-family: var(--font-heading); font-size: calc(1.2 * var(--fs-unit) + 1rem); line-height: 1.2;
  }
  figcaption { font-size: calc(0.2 * var(--fs-unit) + 1rem); }
  .nav {
    position: absolute; top: 50%; translate: 0 -50%;
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--accent); color: #fff; font-size: 1.2rem; opacity: 0.7;
  }
  .nav:hover { opacity: 1; }
  .prev { left: 8vw; }
  .next { right: 8vw; }
  @media (max-width: 767px) {
    blockquote { max-width: none; }
    .slide { padding: 2rem 16vw; }
    .prev { left: 3vw; } .next { right: 3vw; }
  }
</style>
