---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Block from "../components/Block.astro";
import Img from "../components/Img.astro";
import Marquee from "../components/Marquee.astro";
---
<BaseLayout title="Imprint" description="Legal information for Jeff Humble">
  <Section theme="white" height={15} rows={{ mobile: 4, desktop: 5, scale: 0.0215 }}>
    <Block m="1/1/5/11" d="1/1/6/27" z={1} valignM="middle" valign="top">
      <Marquee h1 items={["Imprint"]} textStyle="heading-1" speed={0.5} direction="left" size={8} />
    </Block>

    <Block m="1/1/2/11" d="5/1/6/27" z={4}>
      <hr />
    </Block>

    <Block m="4/1/5/11" d="1/1/2/27" z={3} valignM="middle" valign="bottom">
      <hr />
    </Block>
  </Section>

  <Section theme="white" height="medium" rows={{ mobile: 10, desktop: 30, scale: 0.0215 }}>
    <Block m="1/2/3/10" d="1/14/8/20" z={1} valignM="top">
      <div class="rich text-block">
        <h2>Freelancing Info</h2><p>Jeffrey Humble<br/>bei Huhn<br/>Südwestkorso 6<br/>12161 Berlin<br/>Deutschland<br/><br/>Tel: +49 17674696661<br/>VAT-ID: DE334424725</p>
      </div>
    </Block>

    <Block m="3/2/5/10" d="10/8/31/20" z={2} valign="top">
